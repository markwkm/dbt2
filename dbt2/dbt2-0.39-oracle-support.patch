diff -Nrup dbt2-0.39.orig/scripts/oracle/ctl-external/load_customer.sql dbt2-0.39/scripts/oracle/ctl-external/load_customer.sql
--- dbt2-0.39.orig/scripts/oracle/ctl-external/load_customer.sql	1970-01-01 05:30:00.000000000 +0530
