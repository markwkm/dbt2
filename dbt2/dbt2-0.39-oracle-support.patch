 {
 	SQLRETURN rc;
+
+	/* Input variables. */
+	odbcc->dctx->w_id = data->w_id;
+	odbcc->dctx->o_carrier_id = data->o_carrier_id;
+
+#ifndef ORACLEODBC
 	int i = 1;
 
 	/* Perpare statement for the Delivery transaction. */
-	rc = SQLPrepare(odbcc->hstmt, STMT_DELIVERY, SQL_NTS);
+	rc = SQLPrepare(odbcc->hstmt, (SQLCHAR *)STMT_DELIVERY, SQL_NTS);
 	if (rc != SQL_SUCCESS && rc != SQL_SUCCESS_WITH_INFO) {
 		LOG_ODBC_ERROR(SQL_HANDLE_STMT, odbcc->hstmt);
 		return ERROR;
@@ -36,11 +98,12 @@ int execute_delivery(struct db_context_t
