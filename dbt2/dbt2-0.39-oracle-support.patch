+		LOG_ERROR_MESSAGE("execute_integrity failed");
+	}
+
+	rc = _disconnect_from_db(&dbc);
+	
+	if ( rc != OK ) {
+		LOG_ERROR_MESSAGE("_disconnect_from_db failed");
+	}
+
+	return 0;
+}
