#!/bin/sh
@SHELLOPTIONS@
#
# This file is released under the terms of the Artistic License.
# Please see the file LICENSE, included in this package, for details.
#
# Copyright The DBT-2 Authors
#

usage()
{
	cat << EOF
$(basename "${0}") is the Database Test 2 (DBT-2) Yugabyte database builder.

Usage:
  $(basename "${0}") [OPTION]

Options:
  -i DIRECTORY   DIRECTORY with plpgsql stored functions
  -l PORT        YugabyteDB PORT
  -r             drop existing database before building a new database
  --rows-per-commit ROWS
                 number of ROWS to load per transaction, default is to load all
                 data in a single transaction
  -w WAREHOUSES  number of WAREHOUSES to build, default: 1
  -?, --help     show this help, then exit

@HOMEPAGE@
EOF
}

WAREHOUSES=1
REBUILD_DB=0
ROWS_PER_COMMIT=0
while [ "${#}" -gt 0 ] ; do
	case "${1}" in
	(-i)
		shift
		SHAREDIRARG="-i ${1}"
		;;
	(-l)
		shift
		PORT="${1}"
		;;
	(-r)
		REBUILD_DB=1
		;;
	(--rows-per-commit)
		shift
		ROWS_PER_COMMIT="${1}"
		;;
	(--rows-per-commit=?*)
		ROWS_PER_COMMIT="${1#*--rows-per-commit=}"
		;;
	(-w)
		shift
		WAREHOUSES="${1}"
		;;
	(-\? | --help)
		usage
		exit 0
		;;
	(--* | -*)
		echo "$(basename "${0}"): invalid option -- '${1}'"
		echo "try \"$(basename "${0}") --help\" for more information."
		exit 1
		;;
	(*)
		break
		;;
	esac
	shift
done

if [ ! "${PORT}" = "" ]; then
	PORTARG="-l ${PORT}"
fi

if [ "$REBUILD_DB" -eq 1 ]; then
	dbt2 pgsql-drop-db "${PORTARG}"
fi

dbt2 pgsql-create-db "${PORTARG}" || exit 1
dbt2 pgsql-create-tables "${PORTARG}" || exit 1

SEED=$(dbt2 rand 1 18446744073709551615 0)

# FIXME: Make datagen take argument instead of setting environment variables
# for psql.
if [ ! "${PORT}" = "" ]; then
	export PGPORT="${PORT}"
fi
export PGDATABASE="${DBT2DBNAME}"

if [ "${ROWS_PER_COMMIT}" -gt 0 ]; then
	LOADARGS="--rows-per-commit=${ROWS_PER_COMMIT}"
fi

eval "dbt2 yugabyte-load-db ${PORTARG} -s ${SEED} -w ${WAREHOUSES} \
		${LOADARGS}" || exit 1
dbt2 yugabyte-create-indexes "${PORTARG}" || exit 1
# The C user defined functions are a PostgreSQL extension installed
# alongside the server, and YugabyteDB ships no such extension, so
# plpgsql is the only type that can be loaded.
eval "dbt2 pgsql-load-stored-procs ${SHAREDIRARG} ${PORTARG} \
		-t plpgsql" || exit 1

if [ ! "${PORT}" = "" ]; then
	PORTARG="-p ${PORT}"
fi

SEED=$(dbt2 rand -1 1 15)
psql "${PORTARG}" -e -d "${DBT2DBNAME}" -c "SELECT setseed(${SEED});" || exit 1

exit 0
