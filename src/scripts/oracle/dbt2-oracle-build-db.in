#!/bin/sh
@SHELLOPTIONS@
#
# This file is released under the terms of the Artistic License.
# Please see the file LICENSE, included in this package, for details.
#
# Copyright The DBT-2 Authors
#

usage() {
	cat << EOF
$(basename "${0}") is the Database Test 2 (DBT-2) Oracle database builder.

Usage:
  $(basename "${0}") [OPTION]

Options:
  -d CONNECT     EZConnect string naming the database, e.g.
                 //localhost:1521/FREEPDB1
  -f PATH        PATH to dataset files
  -F PATH        stored procedure PATH
  -g             generate data files
  -P PASSWORD    database PASSWORD, default dbt
  -r             drop existing tables before building new tables
  -u USER        database USER, default dbt
  -V, --version  output version information, then exit
  -w WAREHOUSES  number of WAREHOUSES to build, default: 1
  -?, --help     show this help, then exit

@HOMEPAGE@
EOF
}

DB_NAME=""
DB_PASSWORD="dbt"
DB_PATH=""
DB_USER="dbt"
GENERATE_DATAFILE=0
REBUILD_DB=0
SP_PATH=""
WAREHOUSES=1

while [ "${#}" -gt 0 ] ; do
	case "${1}" in
	(-d)
		shift
		DB_NAME="${1}"
		;;
	(-F)
		shift
		SP_PATH="${1}"
		;;
	(-f)
		shift
		DB_PATH="${1}"
		;;
	(-g)
		GENERATE_DATAFILE=1
		;;
	(-P)
		shift
		DB_PASSWORD="${1}"
		;;
	(-r)
		REBUILD_DB=1
		;;
	(-u)
		shift
		DB_USER="${1}"
		;;
	(-V | --version)
		echo "$(basename "${0}") v@PROJECT_VERSION@"
		exit 0
		;;
	(-w)
		shift
		WAREHOUSES="${1}"
		;;
	(-\? | --help)
		usage
		exit 0
		;;
	(--* | -*)
		echo "$(basename "${0}"): invalid option -- '${1}'"
		echo "try \"$(basename "${0}") --help\" for more information."
		exit 1
		;;
	(*)
		break
		;;
	esac
	shift
done

if [ "${DB_NAME}" = "" ]; then
	echo "specify the database with -d <EZConnect string>" 1>&2
	exit 1
fi
if [ "${DB_PATH}" = "" ]; then
	echo "specify the location of the dataset files with -f <path>" 1>&2
	exit 1
fi

ORACLE_CONNECT="${DB_USER}/${DB_PASSWORD}@${DB_NAME}"

WORKDIR=$(mktemp -d)
trap 'rm -rf "${WORKDIR}"' EXIT

run_sql() {
	sqlplus -S -L "${ORACLE_CONNECT}" <<-EOF
		WHENEVER SQLERROR EXIT 1
		SET HEADING OFF FEEDBACK OFF PAGESIZE 0
		$1
	EOF
}

load_table() {
	sqlldr "${ORACLE_CONNECT}" control="${WORKDIR}/$1.ctl" \
			log="${WORKDIR}/$1.sqlldr.log" \
			bad="${WORKDIR}/$1.bad" errors=0 direct=true \
			> /dev/null 2>&1
	RC=$?
	if [ ${RC} -ne 0 ]; then
		cat "${WORKDIR}/$1.sqlldr.log" 1>&2
		echo "ERROR: sqlldr failed for table $1" 1>&2
		exit 1
	fi
}

if [ ${GENERATE_DATAFILE} -eq 1 ]; then
	dbt2 datagen -d "${DB_PATH}" -w "${WAREHOUSES}" || exit 1
fi

if [ ${REBUILD_DB} -eq 1 ]; then
	# Drop existing tables, ignoring errors for tables that do not
	# exist.
	sqlplus -S -L "${ORACLE_CONNECT}" > /dev/null 2>&1 <<-EOF
		DROP TABLE warehouse PURGE;
		DROP TABLE district PURGE;
		DROP TABLE customer PURGE;
		DROP TABLE history PURGE;
		DROP TABLE item PURGE;
		DROP TABLE new_order PURGE;
		DROP TABLE orders PURGE;
		DROP TABLE order_line PURGE;
		DROP TABLE stock PURGE;
	EOF
fi

# Create the tables with character length semantics because the
# generated strings are multi-byte.
if ! run_sql "
ALTER SESSION SET NLS_LENGTH_SEMANTICS = CHAR;
CREATE TABLE warehouse (
	w_id INTEGER,
	w_name VARCHAR2(10),
	w_street_1 VARCHAR2(20),
	w_street_2 VARCHAR2(20),
	w_city VARCHAR2(20),
	w_state CHAR(2),
	w_zip CHAR(9),
	w_tax NUMBER,
	w_ytd NUMBER);
CREATE TABLE district (
	d_id INTEGER,
	d_w_id INTEGER,
	d_name VARCHAR2(10),
	d_street_1 VARCHAR2(20),
	d_street_2 VARCHAR2(20),
	d_city VARCHAR2(20),
	d_state CHAR(2),
	d_zip CHAR(9),
	d_tax NUMBER,
	d_ytd NUMBER,
	d_next_o_id INTEGER);
CREATE TABLE customer (
	c_id INTEGER,
	c_d_id INTEGER,
	c_w_id INTEGER,
	c_first VARCHAR2(16),
	c_middle CHAR(2),
	c_last VARCHAR2(16),
	c_street_1 VARCHAR2(20),
	c_street_2 VARCHAR2(20),
	c_city VARCHAR2(20),
	c_state CHAR(2),
	c_zip CHAR(9),
	c_phone CHAR(16),
	c_since DATE,
	c_credit CHAR(2),
	c_credit_lim NUMBER,
	c_discount NUMBER,
	c_balance NUMBER,
	c_ytd_payment NUMBER,
	c_payment_cnt NUMBER,
	c_delivery_cnt NUMBER,
	c_data VARCHAR2(500));
CREATE TABLE history (
	h_c_id INTEGER,
	h_c_d_id INTEGER,
	h_c_w_id INTEGER,
	h_d_id INTEGER,
	h_w_id INTEGER,
	h_date DATE,
	h_amount NUMBER,
	h_data VARCHAR2(24));
CREATE TABLE new_order (
	no_o_id INTEGER,
	no_d_id INTEGER,
	no_w_id INTEGER);
CREATE TABLE orders (
	o_id INTEGER,
	o_d_id INTEGER,
	o_w_id INTEGER,
	o_c_id INTEGER,
	o_entry_d DATE,
	o_carrier_id INTEGER,
	o_ol_cnt INTEGER,
	o_all_local NUMBER);
CREATE TABLE order_line (
	ol_o_id INTEGER,
	ol_d_id INTEGER,
	ol_w_id INTEGER,
	ol_number INTEGER,
	ol_i_id INTEGER,
	ol_supply_w_id INTEGER,
	ol_delivery_d DATE,
	ol_quantity NUMBER,
	ol_amount NUMBER,
	ol_dist_info VARCHAR2(24));
CREATE TABLE item (
	i_id INTEGER,
	i_im_id INTEGER,
	i_name VARCHAR2(24),
	i_price NUMBER,
	i_data VARCHAR2(50));
CREATE TABLE stock (
	s_i_id INTEGER,
	s_w_id INTEGER,
	s_quantity NUMBER,
	s_dist_01 VARCHAR2(24),
	s_dist_02 VARCHAR2(24),
	s_dist_03 VARCHAR2(24),
	s_dist_04 VARCHAR2(24),
	s_dist_05 VARCHAR2(24),
	s_dist_06 VARCHAR2(24),
	s_dist_07 VARCHAR2(24),
	s_dist_08 VARCHAR2(24),
	s_dist_09 VARCHAR2(24),
	s_dist_10 VARCHAR2(24),
	s_ytd NUMBER,
	s_order_cnt NUMBER,
	s_remote_cnt NUMBER,
	s_data VARCHAR2(50));
"; then
	echo "ERROR: creating tables failed" 1>&2
	exit 1
fi

# Write a SQL*Loader control file per table.  The data files are
# tab delimited with empty fields for NULL.
DATE_MASK="DATE \"YYYY-MM-DD HH24:MI:SS\""
cat > "${WORKDIR}/warehouse.ctl" <<-EOF
	LOAD DATA
	CHARACTERSET AL32UTF8
	INFILE '${DB_PATH}/warehouse.data'
	APPEND
	INTO TABLE warehouse
	FIELDS TERMINATED BY X'09'
	TRAILING NULLCOLS
	(w_id, w_name, w_street_1, w_street_2, w_city, w_state,
	w_zip, w_tax, w_ytd)
EOF
cat > "${WORKDIR}/district.ctl" <<-EOF
	LOAD DATA
	CHARACTERSET AL32UTF8
	INFILE '${DB_PATH}/district.data'
	APPEND
	INTO TABLE district
	FIELDS TERMINATED BY X'09'
	TRAILING NULLCOLS
	(d_id, d_w_id, d_name, d_street_1, d_street_2, d_city,
	d_state, d_zip, d_tax, d_ytd, d_next_o_id)
EOF
cat > "${WORKDIR}/customer.ctl" <<-EOF
	LOAD DATA
	CHARACTERSET AL32UTF8
	INFILE '${DB_PATH}/customer.data'
	APPEND
	INTO TABLE customer
	FIELDS TERMINATED BY X'09'
	TRAILING NULLCOLS
	(c_id, c_d_id, c_w_id, c_first, c_middle, c_last,
	c_street_1, c_street_2, c_city, c_state, c_zip, c_phone,
	c_since ${DATE_MASK}, c_credit, c_credit_lim, c_discount,
	c_balance, c_ytd_payment, c_payment_cnt, c_delivery_cnt,
	c_data CHAR(2000))
EOF
cat > "${WORKDIR}/history.ctl" <<-EOF
	LOAD DATA
	CHARACTERSET AL32UTF8
	INFILE '${DB_PATH}/history.data'
	APPEND
	INTO TABLE history
	FIELDS TERMINATED BY X'09'
	TRAILING NULLCOLS
	(h_c_id, h_c_d_id, h_c_w_id, h_d_id, h_w_id,
	h_date ${DATE_MASK}, h_amount, h_data)
EOF
cat > "${WORKDIR}/new_order.ctl" <<-EOF
	LOAD DATA
	CHARACTERSET AL32UTF8
	INFILE '${DB_PATH}/new_order.data'
	APPEND
	INTO TABLE new_order
	FIELDS TERMINATED BY X'09'
	TRAILING NULLCOLS
	(no_o_id, no_d_id, no_w_id)
EOF
cat > "${WORKDIR}/orders.ctl" <<-EOF
	LOAD DATA
	CHARACTERSET AL32UTF8
	INFILE '${DB_PATH}/order.data'
	APPEND
	INTO TABLE orders
	FIELDS TERMINATED BY X'09'
	TRAILING NULLCOLS
	(o_id, o_d_id, o_w_id, o_c_id, o_entry_d ${DATE_MASK},
	o_carrier_id, o_ol_cnt, o_all_local)
EOF
cat > "${WORKDIR}/order_line.ctl" <<-EOF
	LOAD DATA
	CHARACTERSET AL32UTF8
	INFILE '${DB_PATH}/order_line.data'
	APPEND
	INTO TABLE order_line
	FIELDS TERMINATED BY X'09'
	TRAILING NULLCOLS
	(ol_o_id, ol_d_id, ol_w_id, ol_number, ol_i_id,
	ol_supply_w_id, ol_delivery_d ${DATE_MASK}, ol_quantity,
	ol_amount, ol_dist_info)
EOF
cat > "${WORKDIR}/item.ctl" <<-EOF
	LOAD DATA
	CHARACTERSET AL32UTF8
	INFILE '${DB_PATH}/item.data'
	APPEND
	INTO TABLE item
	FIELDS TERMINATED BY X'09'
	TRAILING NULLCOLS
	(i_id, i_im_id, i_name, i_price, i_data)
EOF
cat > "${WORKDIR}/stock.ctl" <<-EOF
	LOAD DATA
	CHARACTERSET AL32UTF8
	INFILE '${DB_PATH}/stock.data'
	APPEND
	INTO TABLE stock
	FIELDS TERMINATED BY X'09'
	TRAILING NULLCOLS
	(s_i_id, s_w_id, s_quantity, s_dist_01, s_dist_02,
	s_dist_03, s_dist_04, s_dist_05, s_dist_06, s_dist_07,
	s_dist_08, s_dist_09, s_dist_10, s_ytd, s_order_cnt,
	s_remote_cnt, s_data)
EOF

for TABLE in warehouse district customer history new_order orders \
		order_line item stock; do
	echo "Loading table ${TABLE}"
	load_table "${TABLE}"
done

if ! run_sql "
ALTER TABLE warehouse ADD PRIMARY KEY (w_id);
ALTER TABLE district ADD PRIMARY KEY (d_w_id, d_id);
ALTER TABLE customer ADD PRIMARY KEY (c_w_id, c_d_id, c_id);
ALTER TABLE new_order ADD PRIMARY KEY (no_w_id, no_d_id, no_o_id);
ALTER TABLE orders ADD PRIMARY KEY (o_w_id, o_d_id, o_id);
ALTER TABLE order_line ADD PRIMARY KEY (ol_w_id, ol_d_id, ol_o_id,
	ol_number);
ALTER TABLE item ADD PRIMARY KEY (i_id);
ALTER TABLE stock ADD PRIMARY KEY (s_w_id, s_i_id, s_quantity);
CREATE INDEX i_orders ON orders (o_w_id, o_d_id, o_c_id);
CREATE INDEX i_customer ON customer (c_w_id, c_d_id, c_last,
	c_first, c_id);
"; then
	echo "ERROR: creating constraints and indexes failed" 1>&2
	exit 1
fi

# Load the stored procedures, verifying compilation against
# user_errors because sqlplus exits successfully when a procedure
# is created with compilation errors.
if [ ! "${SP_PATH}" = "" ]; then
	for SP in delivery neworder order_status payment stock_level; do
		echo "Loading stored procedure ${SP}"
		sqlplus -S -L "${ORACLE_CONNECT}" "@${SP_PATH}/${SP}.sql" \
				< /dev/null \
				> "${WORKDIR}/${SP}.sqlplus.log" 2>&1
	done
	ERRORS=$(run_sql "SELECT count(*) FROM user_errors
			WHERE type = 'PROCEDURE';" | tr -d " \t")
	if [ ! "${ERRORS}" = "0" ]; then
		cat "${WORKDIR}"/*.sqlplus.log 1>&2
		run_sql "SET HEADING ON
		SELECT name, type, line, position, text
		FROM user_errors
		WHERE type = 'PROCEDURE';" 1>&2
		echo "ERROR: loading stored procedures failed" 1>&2
		exit 1
	fi
fi
