##############################################################################
#Generic Env

# Location of kit
export SRCHOME=../../../../

# Oracle db user and password.
export DBUSER=dbt
export DBPASSWD=dbt

# OS user
USER=`id -un`

# Name of the kit
export KITNAME=dbt2

# Database name
export DBNAME=oradbt

# Instance name
export INSTANCENAME=${DBNAME}

# Service name used in init.ora, tnsnames.ora and listener.ora
export SERVICENAME=${DBNAME}

# tnsalias in tnsnames.ora
export TNSALIAS=${DBNAME}

# SID for oracle instance
export SID=${DBNAME}

# init.ora parameter sga_target
export SGATARGET=true

# port number used by listner and clients 
export PORTNUM=1521

# Listener name
export LISTENERNAME="DYNAMICLISTENER"

# IPCKEY used by listener
export IPCKEY="EXTPROC"

# datafiles generated by datagen
export DATAFILES="item warehouse stock district customer history order order_line new_order"

# sql to load all tables with data generated by datagen
export LOADSQL="load_customer.sql load_history.sql load_new_order.sql load_order.sql load_warehouse.sql load_district.sql load_item.sql load_order_line.sql load_stock.sql"

# name of all user tables in the database
export ALLTABLES="warehouse district customer history orders new_order order_line stock item"

# name of all user indexes in the database
export ALLINDEXES="iwarehouse idistrict iitem icustomer1 icustomer2 istock iorder1 iorder2"

# name of all stored procedures
export STRDPROC="delivery.sql neworder.sql order_status.sql payment.sql stock_level.sql"

########################################################################################
# env related to install

# Install tmp directory
ITMPDIR=${WORKHOME}/tmp

# Install Server directory
ISERVER=${ITMPDIR}/server

# Install Server Warehouse directory , under this directory all script will be present.
ISWARE=${ISERVER}/warehouse$WAREHOUSE

# Install Server Config directory, and need to create sub directory for each node.
ISCONFIG=$ISERVER/config

# Install user env file
#IUSERENV=$ISCONFIG/userenv

# Install Client directory
ICLIENT=${ITMPDIR}/client

# Install Client Config directory.
ICCONFIG=${ICLIENT}/config

# Install Client Scripts directory
ICSCRIPTS=${ICLIENT}/scripts


######################################################################################### 
# env related to src home and templates
export SRCKIT=${SRCHOME}/$KITNAME
export SRCSCRIPTS=${SRCKIT}/scripts
export SORACLE=${SRCKIT}/scripts/oracle
export SCONFIGDIR=${SORACLE}/config


######################################
#env related to server 
#
export WORKDIR=${WORKHOME}/${KITNAME}-work

# Work Server directory
export WSERVER=${WORKDIR}/server

# Work Server Warehouse directory
export WSWARE=${WSERVER}/warehouse$WAREHOUSE

# Work Config directory
export WSCONFIG=${WSERVER}/config

# Work Serverenv file  
export SERVERENV=${WSCONFIG}/server.env

export USERENV=${WSCONFIG}/user.env

#create these directory during the run because user can run multiple testnames.
# Work Server Result directory
export WSRESULT=${WSERVER}/result

# Work Server Result Log directory
export WSRLOG=${WSRESULT}/log

# new
export WSRTEST=${WSRESULT}/${TESTNAME}
#export WSRTEST=${WSRESULT}/

# Work Server Result Log Db-log directory
export WSRLDB=${WSRLOG}/db-logs

# Work Server Result Analyze directory
#export WSRANALYZE=${WSRESULT}/analyze
export WSRANALYZE=${WSRTEST}/analyze

# Work Server Result Oracle Alert directory
export WSRALERT=${WSRESULT}/ora-alert

# Work Server Result Oracle Alert create db directory
export WSRACREATE=${WSRALERT}/create-db

# Work Server Result Oracle Alert load db directory
#export WSRALOAD=${WSRALERT}/load-db

# Work Server Result Oracle Alert run db directory
export WSRARUN=${WSRALERT}/run-db
#export WSRARUN=${WSRTEST}/run-db

# Work Server Result Metrics directory
export WSRMETRICS=${WSRTEST}/metrics



######################################
#env related to client

# Work Client Directory
export WCLIENT=${WORKDIR}/client

# Work Client Config directory
export WCCONFIG=${WCLIENT}/config

# Work Serverenv file
export CLIENTENV=${WCCONFIG}/client.env

# Work Client Scripts directory
export WCSCRIPTS=${WCLIENT}/scripts

# Work Client Log directory
export WCLOG=${WCLIENT}/${TESTNAME}-log


#####################################333
export TESTSETUP=${WSCONFIG}/testsetup.env




