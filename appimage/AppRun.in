#!/bin/sh
@SHELLOPTIONS@

# ARGV0 is only set by the AppImage runtime; fall back to $0 when running
# from an extracted AppDir.
ARGV0="${ARGV0:-${0}}"

usage() {
	cat << EOF
Database Test 2 (DBT-2) wrapped up in an AppImage.

Usage:
  $(basename "${ARGV0}") COMMAND [OPTION]

Options:
  The OPTION choices depend on the COMMAND specified.  The -h flag will
  display the available options.

  -? | --help     Display this usage message, then exit.
  -V | --version  Display the kit version, then exit.  Use with --verbose
                  to also display versions of programs bundled in the
                  AppImage.

Help command:
  man   This COMMAND displays the man page for any of the general commands
        below when given as its OPTION, or the dbt2 man page when no OPTION
        is given.  (Note: man pages are not available for all available
        commands, yet.)

Commands:
$(find "${APPDIR}/usr/bin" -maxdepth 1 -type f -name "dbt2-*" \
	-printf "%f\n" | sort | sed -e "s/dbt2-/  /")


@HOMEPAGE@
EOF
}

if [ "${APPDIR}" = "" ]; then
	APPDIR="$(cd -- "$(dirname -- "${0}")" && pwd)"
fi

if [ $# -eq 0 ]; then
	usage
	exit 1
fi

VERBOSE=0
VERSION=0

# Custom argument handling for hopefully most portability.
while [ "${#}" -gt 0 ] ; do
	case "${1}" in
	(man)
		if [ "${MANPATH}" = "" ]; then
			export MANPATH="${APPDIR}/usr/share/man"
		else
			export MANPATH="${APPDIR}/usr/share/man:${MANPATH}"
		fi
		if [ "${2}" = "" ]; then
			man dbt2
		else
			man "dbt2-${2}"
		fi
		exit $?
		;;
	(--verbose)
		VERBOSE=1
		;;
	(-V | --version)
		VERSION=1
		;;
	(-\? | --help)
		usage
		exit 0
		;;
	(--* | -*)
		echo "$(basename "${ARGV0}"): invalid option -- '${1}'"
		echo "try \"$(basename "${ARGV0}") --help\" for more information."
		exit 1
		;;
	(*)
		break
		;;
	esac
	shift
done

if [ $VERSION -eq 1 ]; then
	if [ $VERBOSE -eq 1 ]; then
		"${APPDIR}/usr/bin/dbt2" --version --verbose
	else
		"${APPDIR}/usr/bin/dbt2" --version
	fi
	exit 0
fi

export PATH="${APPDIR}/usr/bin:${PATH}"

if [ "${LD_LIBRARY_PATH}" = "" ]; then
	export LD_LIBRARY_PATH="${APPDIR}/usr/lib"
else
	export LD_LIBRARY_PATH="${APPDIR}/usr/lib:${LD_LIBRARY_PATH}"
fi

if [ "$PGHOST" = "" ]; then
	export PGHOST="/tmp,/var/run/postgresql"
fi

if [ "${PERL5LIB}" = "" ]; then
	export PERL5LIB="${APPDIR}/etc/perl"
else
	export PERL5LIB="${APPDIR}/etc/perl:${PERL5LIB}"
fi

COMMAND="${APPDIR}/usr/bin/dbt2-${1}"

if [ ! -f "$COMMAND" ]; then
	echo "COMMAND '${1}' not found, run '$(basename "${ARGV0}")' without" \
			"arguments for usage."
	exit 1
fi

shift

exec "${COMMAND}" "$@"
